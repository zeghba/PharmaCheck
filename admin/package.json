{
  "name": "pharmacheck-admin",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "PharmaCheck super-admin — provisions pharmacies and manages their accounts.",
  "dependencies": {
    "expo": "^57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "bundle:web": "node scripts/bundle-web.js",
    "postinstall": "node scripts/bundle-web.js",
    "prestart": "node scripts/bundle-web.js",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "apk": "npm run bundle:web && expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  }
}
